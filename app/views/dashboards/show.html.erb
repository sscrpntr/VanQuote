<div class="dashboard-page">
  <section class="dashboard-card" aria-labelledby="dashboard-greeting">
    <p class="dashboard-brand">VanQuote</p>
    <h1 id="dashboard-greeting">
      <%= t("dashboard.greeting") %>
    </h1>

    <div class="dashboard-actions">
      <%= link_to quotes_path, class: "dashboard-action" do %>
        <span><%= t("dashboard.my_quotes") %></span>
      <% end %>
      <%= link_to new_quote_path, class: "dashboard-action" do %>
        <span><%= t("dashboard.new_quote") %></span>
      <% end %>
      <%= link_to profile_path, class: "dashboard-action" do %>
        <span><%= t("dashboard.profile") %></span>
      <% end %>
    </div>
    <%= button_to t("dashboard.logout"), session_path, method: :delete, class: "button-secondary dashboard-logout" %>
  </section>
</div>
