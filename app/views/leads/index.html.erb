<div>
  <h1><%= t("leads.index.title") %></h1>

  <% if @leads.empty? %>
    <p><%= t("leads.index.empty") %></p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th><%= t("leads.index.email") %></th>
          <th><%= t("leads.index.origin") %></th>
          <th><%= t("leads.index.destination") %></th>
          <th><%= t("leads.index.recommended_price") %></th>
          <th><%= t("leads.index.status") %></th>
          <th><%= t("leads.index.date") %></th>
        </tr>
      </thead>

      <tbody>
        <% @leads.each do |lead| %>
          <tr>
            <td><%= lead.email %></td>
            <td><%= lead.quote.origin %></td>
            <td><%= lead.quote.destination %></td>
            <td>
              <%= number_to_currency(
                lead.quote.recommended_price,
                unit: "€"
              ) %>
            </td>
            <td><%= lead.status %></td>
            <td>
              <%= l(lead.created_at, format: :short) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
