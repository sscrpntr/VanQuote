<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1><%= t("leads.edit.title") %></h1>

        <p>
          <%= t("leads.edit.subtitle") %>
        </p>
      </div>

      <% if @lead.errors.any? %>
        <div class="auth-alert">
          <%= @lead.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: @lead,
            url: lead_path(@lead),
            method: :patch,
            class: "auth-form" do |form| %>

        <div class="auth-field">
          <% if @phone_preference_locked %>
            <span class="form-label"><%= t("leads.edit.contact_preference.label") %></span>
            <p class="contact-preference-value" role="status">
              <%= t("leads.edit.contact_preference.phone_value") %>
            </p>
          <% else %>
            <%= form.label :contact_preference,
                  t("leads.edit.contact_preference.label") %>

            <%= form.select :contact_preference,
                  options_for_select(
                    [
                      [
                        t("leads.edit.contact_preference.options.email_quote"),
                        "EMAIL_QUOTE"
                      ],
                      [
                        t("leads.edit.contact_preference.options.phone"),
                        "PHONE"
                      ],
                      [
                        t("leads.edit.contact_preference.options.email_contact"),
                        "EMAIL_CONTACT"
                      ]
                    ],
                    @lead.contact_preference
                  ),
                  {},
                  required: true %>
          <% end %>
        </div>

        <div class="auth-field">
          <%= form.label :phone,
                t("leads.edit.phone.label") %>

          <%= form.telephone_field :phone,
                autofocus: true,
                autocomplete: "tel",
                required: true,
                placeholder: "+41 79 123 45 67" %>

          <small>
            <%= t("leads.edit.phone.help") %>
          </small>
        </div>

        <%= form.submit t("leads.edit.submit"),
              class: "button-primary auth-submit" %>
      <% end %>

      <p class="auth-back-link">
        <%= link_to t("leads.edit.back_to_vanquote"), root_path, class: "action-link" %>
      </p>
    </div>
  </div>
</div>
