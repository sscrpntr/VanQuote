<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1><%= t("passwords.new.title") %></h1>

        <p>
          <%= t("passwords.new.subtitle") %>
        </p>
      </div>

      <% if flash[:alert] %>
        <div class="auth-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="auth-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: passwords_path, class: "auth-form", data: { locale_draft: "password_reset_request" } do |form| %>
        <div class="auth-field">
          <%= form.label :email_address,
                t("passwords.new.email.label") %>

          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "username",
                placeholder: t("passwords.new.email.placeholder"),
                value: locale_form_value("password_reset_request", "email_address", params[:email_address]) %>
        </div>

        <%= form.submit t("passwords.new.submit"),
              class: "button-primary auth-submit" %>
      <% end %>

      <p class="auth-back-link">
        <%= link_to t("passwords.new.back_to_sign_in"),
              new_session_path,
              class: "action-link" %>
      </p>
    </div>

    <p class="auth-back-link">
      <%= link_to t("passwords.new.back_to_vanquote"), root_path, class: "action-link" %>
    </p>
  </div>
</div>
