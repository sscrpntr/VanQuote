<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1><%= t("sessions.new.title") %></h1>

        <p>
          <%= t("sessions.new.subtitle") %>
        </p>
      </div>

      <% if flash[:alert] %>
        <div class="auth-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="auth-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: session_path, class: "auth-form" do |form| %>
        <div class="auth-field">
          <%= form.label :email_address, t("sessions.new.email.label") %>

          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "username",
                placeholder: t("sessions.new.email.placeholder"),
                value: params[:email_address] %>
        </div>

        <div class="auth-field">
          <div class="auth-field-header">
            <%= form.label :password, t("sessions.new.password.label") %>

            <%= link_to t("sessions.new.forgot_password"),
                  new_password_path,
                  class: "action-link auth-forgot-link" %>
          </div>

          <%= form.password_field :password,
                required: true,
                autocomplete: "current-password",
                placeholder: t("sessions.new.password.placeholder"),
                maxlength: 72 %>
        </div>

        <%= form.submit t("sessions.new.submit"), class: "button-primary auth-submit" %>
      <% end %>

      <div class="auth-divider">
        <span><%= t("sessions.new.or") %></span>
      </div>

      <%= render "shared/social_authentication", translation_scope: "sessions.new" %>

      <div class="auth-footer">
        <span><%= t("sessions.new.no_account") %></span>

        <%= link_to t("sessions.new.create_account"),
              new_registration_path(
                quote_token: session[:quote_token_after_authenticating],
                contact_preference: session[:contact_preference_after_authenticating]
              ),
              class: "action-link auth-register-link" %>
      </div>
    </div>

    <p class="auth-back-link">
      <%= link_to t("sessions.new.back_to_vanquote"),
            session[:quote_token_after_authenticating].present? ? public_quotes_path(token: session[:quote_token_after_authenticating]) : root_path,
            class: "action-link" %>
    </p>
  </div>
</div>
