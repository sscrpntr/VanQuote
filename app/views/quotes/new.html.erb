<div class="quote-page">
  <div class="quote-container">
    <header class="quote-header">
      <h1 class="quote-logo">VanQuote</h1>

      <p class="quote-subtitle">
        <%= t("quotes.new.subtitle") %>
      </p>
    </header>

    <div
      class="quote-card"
      data-controller="place-autocomplete"
      data-place-autocomplete-api-key-value="<%= ENV["GOOGLE_MAPS_BROWSER_API_KEY"] %>"
    >
      <%= form_with model: @quote,
            local: true,
            class: "quote-form" do |form| %>

        <div class="form-field">
          <%= form.label :origin,
                t("quotes.new.origin.label"),
                class: "form-label" %>

          <%= form.text_field :origin,
                placeholder: t("quotes.new.origin.placeholder"),
                class: "form-input",
                data: {
                  place_autocomplete_target: "originInput"
                } %>
        </div>

        <div class="form-field">
          <%= form.label :destination,
                t("quotes.new.destination.label"),
                class: "form-label" %>

          <%= form.text_field :destination,
                placeholder: t("quotes.new.destination.placeholder"),
                class: "form-input",
                data: {
                  place_autocomplete_target: "destinationInput"
                } %>
        </div>

        <div class="form-field">
          <%= label_tag :email,
                t("quotes.new.email.label"),
                class: "form-label" %>

          <%= email_field_tag :email,
                params[:email],
                required: true,
                placeholder: t("quotes.new.email.placeholder"),
                class: "form-input" %>
        </div>

        <div class="form-consent">
          <%= check_box_tag :consent_given,
                "1",
                false,
                required: true %>

          <%= label_tag :consent_given,
                t("quotes.new.consent") %>
        </div>

        <%= form.submit t("quotes.new.submit"),
              class: "button-primary" %>
      <% end %>
    </div>
  </div>
</div>
