<div class="landing-page">
  <section class="landing-hero" aria-labelledby="landing-title">
    <div class="landing-hero-inner">
      <div class="landing-copy">
        <h1 id="landing-title"><%= t("landing.headline") %></h1>
        <p class="landing-subtitle"><%= t("landing.subtitle") %></p>

        <ul class="landing-benefits">
          <li><span aria-hidden="true">⚡</span><%= t("landing.benefits.fast") %></li>
          <li><span aria-hidden="true">📍</span><%= t("landing.benefits.route") %></li>
          <li><span aria-hidden="true">🚐</span><%= t("landing.benefits.tailored") %></li>
        </ul>
      </div>

      <div class="landing-form-column">
        <div
          id="quote-form"
          class="quote-card landing-form-card"
          data-controller="place-autocomplete"
          data-place-autocomplete-api-key-value="<%= ENV["GOOGLE_MAPS_BROWSER_API_KEY"] %>"
        >
          <h2><%= t("landing.form_title") %></h2>

          <%= form_with model: @quote,
                local: true,
                class: "quote-form" do |form| %>

            <div class="form-field">
              <%= form.label :origin,
                    t("quotes.new.origin.label"),
                    class: "form-label" %>

              <%= form.text_field :origin,
                    placeholder: t("quotes.new.origin.placeholder"),
                    class: "form-input",
                    data: {
                      place_autocomplete_target: "originInput"
                    } %>
            </div>

            <div class="form-field">
              <%= form.label :destination,
                    t("quotes.new.destination.label"),
                    class: "form-label" %>

              <%= form.text_field :destination,
                    placeholder: t("quotes.new.destination.placeholder"),
                    class: "form-input",
                    data: {
                      place_autocomplete_target: "destinationInput"
                    } %>
            </div>

            <div class="form-field landing-email-field">
              <div class="landing-email-label-row">
                <%= label_tag :email,
                      t("quotes.new.email.label"),
                      class: "form-label" %>
                <details class="landing-email-info">
                  <summary aria-label="<%= t('quotes.new.email.info_label') %>">
                    <span aria-hidden="true">i</span>
                  </summary>
                  <p><%= t("quotes.new.email.info") %></p>
                </details>
              </div>

              <%= email_field_tag :email,
                    Current.user&.email_address || params[:email],
                    required: true,
                    readonly: Current.user.present?,
                    autocomplete: "email",
                    placeholder: t("quotes.new.email.placeholder"),
                    class: "form-input" %>
            </div>

            <%= form.submit t("quotes.new.submit"),
                  class: "button-primary landing-submit" %>
          <% end %>
        </div>

        <section class="quote-account-access landing-account-access" aria-label="<%= t('quotes.new.account_access.title') %>">
          <div class="quote-account-option">
            <p><%= t("quotes.new.account_access.sign_in_prompt") %></p>
            <%= link_to t("quotes.new.account_access.sign_in"), new_session_path, class: "button-secondary" %>
          </div>

          <div class="quote-account-option">
            <p><%= t("quotes.new.account_access.register_prompt") %></p>
            <%= link_to t("quotes.new.account_access.register"), new_registration_path, class: "button-secondary" %>
          </div>
        </section>
      </div>

      <p class="landing-assurance"><%= t("landing.assurance") %></p>
    </div>
  </section>

  <section class="landing-content-section landing-how" aria-labelledby="landing-how-title">
    <div class="landing-section-inner">
      <h2 id="landing-how-title"><%= t("landing.how.title") %></h2>
      <ol class="landing-steps">
        <li>
          <span class="landing-step-number">01</span>
          <p><%= t("landing.how.step_one") %></p>
        </li>
        <li>
          <span class="landing-step-number">02</span>
          <p><%= t("landing.how.step_two") %></p>
        </li>
        <li>
          <span class="landing-step-number">03</span>
          <p><%= t("landing.how.step_three") %></p>
        </li>
      </ol>
    </div>
  </section>

  <section class="landing-content-section landing-use-cases" aria-labelledby="landing-use-cases-title">
    <div class="landing-section-inner">
      <h2 id="landing-use-cases-title"><%= t("landing.use_cases.title") %></h2>
      <ul class="landing-category-list">
        <li><%= t("landing.use_cases.moving") %></li>
        <li><%= t("landing.use_cases.furniture") %></li>
        <li><%= t("landing.use_cases.transport") %></li>
      </ul>
    </div>
  </section>

  <section class="landing-content-section landing-pricing" aria-labelledby="landing-pricing-title">
    <div class="landing-section-inner">
      <h2 id="landing-pricing-title"><%= t("landing.pricing.title") %></h2>
      <p><%= t("landing.pricing.factors") %></p>
    </div>
  </section>

  <section class="landing-final-cta" aria-labelledby="landing-cta-title">
    <div class="landing-section-inner">
      <h2 id="landing-cta-title"><%= t("landing.cta.title") %></h2>
      <p><%= t("landing.cta.subtitle") %></p>
      <%= link_to t("landing.cta.button"), new_quote_path, class: "button-primary landing-cta-button" %>
    </div>
  </section>
</div>
