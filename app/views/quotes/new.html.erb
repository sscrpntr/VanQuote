<div class="quote-page">
  <div class="quote-container">
    <header class="quote-header">
      <h1 class="quote-logo">VanQuote</h1>

      <p class="quote-subtitle">
        Calcula qué precio tiene el transporte de tus sueños
      </p>
    </header>

    <div
      class="quote-card"
      data-controller="place-autocomplete"
      data-place-autocomplete-api-key-value="<%= ENV["GOOGLE_MAPS_BROWSER_API_KEY"] %>"
    >
      <%= form_with model: @quote,
            local: true,
            class: "quote-form" do |form| %>

        <div class="form-field">
          <%= form.label :origin,
                "Origen",
                class: "form-label" %>

          <%= form.text_field :origin,
                placeholder: "Escribe una dirección de origen",
                class: "form-input",
                data: {
                  place_autocomplete_target: "originInput"
                } %>
        </div>

        <div class="form-field">
          <%= form.label :destination,
                "Destino",
                class: "form-label" %>

          <%= form.text_field :destination,
                placeholder: "Escribe una dirección de destino",
                class: "form-input",
                data: {
                  place_autocomplete_target: "destinationInput"
                } %>
        </div>

        <div class="form-field">
          <%= label_tag :email,
                "Email",
                class: "form-label" %>

          <%= email_field_tag :email,
                params[:email],
                required: true,
                placeholder: "tu@email.com",
                class: "form-input" %>
        </div>

        <div class="form-consent">
          <%= check_box_tag :consent_given,
                "1",
                false,
                required: true %>

          <%= label_tag :consent_given,
                "Acepto recibir este presupuesto y ser contactado por email." %>
        </div>

        <%= form.submit "Calcular presupuesto",
              class: "form-submit" %>
      <% end %>
    </div>
  </div>
</div>
