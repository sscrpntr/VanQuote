<div>
  <h1>VanQuote</h1>

  <p>Calcula cuánto deberías cobrar por un transporte.</p>

  <%= form_with model: @quote, local: true do |form| %>
    <div>
      <%= form.label :origin, "Origen" %>
      <%= form.text_field :origin %>
    </div>

    <div>
      <%= form.label :destination, "Destino" %>
      <%= form.text_field :destination %>
    </div>

    <div>
      <%= label_tag :email, "Email" %>
      <%= email_field_tag :email, params[:email], required: true %>
    </div>

    <div>
      <%= check_box_tag :consent_given, "1", false, required: true %>
      <%= label_tag :consent_given, "Acepto recibir este presupuesto y ser contactado por email." %>
    </div>

    <div>
      <%= form.submit "Calcular presupuesto" %>
    </div>
  <% end %>
</div>
