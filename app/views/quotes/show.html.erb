<div>
  <h1>Presupuesto de transporte</h1>

  <p>
    <strong>Origen:</strong>
    <%= @quote.origin %>
  </p>

  <p>
    <strong>Destino:</strong>
    <%= @quote.destination %>
  </p>

  <hr>

  <h2>Precio del transporte</h2>

  <p>
    <strong><%= number_to_currency(@calculator.recommended_price, unit: "€") %></strong>
  </p>

  <% if notice.present? %>
    <p>
      <strong><%= notice %></strong>
    </p>

    <p>
      <%= link_to "Cambiar método de contacto", quote_path(@quote) %>
    </p>
  <% elsif @quote.lead.present? %>
    <h2>¿Te interesa este presupuesto?</h2>

    <p>Elige cómo quieres continuar:</p>

    <div>
      <%= form_with model: @quote.lead, url: lead_path(@quote.lead), method: :patch do |form| %>
        <%= form.hidden_field :contact_preference, value: "EMAIL_QUOTE" %>
        <%= form.submit "Enviar presupuesto por email" %>
      <% end %>

      <%= form_with model: @quote.lead, url: lead_path(@quote.lead), method: :patch do |form| %>
        <%= form.hidden_field :contact_preference, value: "PHONE" %>

        <div>
          <%= form.label :phone, "Número de teléfono" %>
          <%= form.telephone_field :phone,
                                   required: true,
                                   placeholder: "+41 79 123 45 67" %>
        </div>

        <%= form.submit "Quiero recibir una llamada" %>
      <% end %>

      <%= form_with model: @quote.lead, url: lead_path(@quote.lead), method: :patch do |form| %>
        <%= form.hidden_field :contact_preference, value: "EMAIL_CONTACT" %>
        <%= form.submit "Quiero recibir contacto por email" %>
      <% end %>
    </div>
  <% end %>

  <p>
    <%= link_to "Nueva cotización", root_path %>
  </p>
</div>
