<div>
  <h1>Presupuesto de transporte</h1>

  <p>
    <strong>Origen:</strong>
    <%= @quote.origin %>
  </p>

  <p>
    <strong>Destino:</strong>
    <%= @quote.destination %>
  </p>

  <hr>

  <p>
    <strong>Coste real:</strong>
    <%= number_to_currency(@calculator.total_cost, unit: "€") %>
  </p>

  <p>
    <strong>Margen:</strong>
    <%= @quote.margin %>%
  </p>

  <h2>Opciones de precio</h2>

  <p>
    <strong>Precio mínimo:</strong>
    <%= number_to_currency(@calculator.minimum_price, unit: "€") %>
  </p>

  <p>
    <strong>Precio recomendado:</strong>
    <%= number_to_currency(@calculator.recommended_price, unit: "€") %>
  </p>

  <p>
    <strong>Precio premium:</strong>
    <%= number_to_currency(@calculator.premium_price, unit: "€") %>
  </p>

  <%= link_to "Nueva cotización", root_path %>
</div>
