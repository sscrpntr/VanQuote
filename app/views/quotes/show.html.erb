<div class="quote-page">
  <div class="quote-container">
    <header class="quote-header">
      <h1 class="quote-logo">VanQuote</h1>

      <p class="quote-subtitle">
        <%= t("quotes.show.subtitle") %>
      </p>
    </header>

    <div class="quote-card quote-result-card">
      <% if flash[:notice] %>
        <div class="auth-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="auth-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <div class="route-summary">
        <div class="route-point">
          <span class="route-label"><%= t("quotes.show.origin") %></span>
          <span class="route-address"><%= @quote.origin %></span>
        </div>

        <div class="route-arrow" aria-hidden="true">
          ↓
        </div>

        <div class="route-point">
          <span class="route-label"><%= t("quotes.show.destination") %></span>
          <span class="route-address"><%= @quote.destination %></span>
        </div>
      </div>

      <div class="price-section">
        <p class="price-label">
          <%= t("quotes.show.price_label") %>
        </p>

        <p class="price-value">
          <%= number_to_currency(
                @calculator.recommended_price,
                unit: "€",
                format: "%n %u"
              ) %>
        </p>

        <p class="price-description">
          <%= t("quotes.show.price_description") %>
        </p>
      </div>

      <% if @quote.lead.present? %>
        <div class="contact-section">
          <h2><%= t("quotes.show.contact.title") %></h2>

          <p class="contact-description">
            <%= t("quotes.show.contact.description") %>
          </p>

          <div class="contact-options">
            <%= form_with model: @quote.lead,
                  url: lead_path(@quote.lead),
                  method: :patch,
                  class: "contact-option" do |form| %>

              <%= form.hidden_field :contact_preference,
                    value: "EMAIL_QUOTE" %>

              <%= form.submit t("quotes.show.contact.email_quote"),
                    class: "button-secondary contact-button" %>
            <% end %>

            <%= form_with model: @quote.lead,
                  url: lead_path(@quote.lead),
                  method: :patch,
                  class: "contact-option" do |form| %>

              <%= form.hidden_field :contact_preference,
                    value: "PHONE" %>

              <%= form.label :phone,
                    t("quotes.show.contact.phone.label"),
                    class: "form-label" %>

              <%= form.telephone_field :phone,
                    required: true,
                    placeholder: "+41 79 123 45 67",
                    class: "form-input" %>

              <%= form.submit t("quotes.show.contact.phone.submit"),
                    class: "button-secondary contact-button" %>
            <% end %>

            <%= form_with model: @quote.lead,
                  url: lead_path(@quote.lead),
                  method: :patch,
                  class: "contact-option" do |form| %>

              <%= form.hidden_field :contact_preference,
                    value: "EMAIL_CONTACT" %>

              <%= form.submit t("quotes.show.contact.email_contact"),
                    class: "button-secondary contact-button" %>
            <% end %>
          </div>

          <%= link_to t("quotes.show.contact.change_method"),
                edit_lead_path(@quote.lead),
                class: "action-link" %>
        </div>
      <% else %>
        <div class="contact-section">
          <h2><%= t("quotes.public.contact.title") %></h2>
          <p class="contact-description"><%= t("quotes.public.contact.description") %></p>
          <div class="contact-options">
            <% Lead::CONTACT_PREFERENCES.each do |preference| %>
              <%= link_to t("quotes.public.contact.#{preference.downcase}"),
                    new_session_path(
                      quote_token: @quote.signed_id(purpose: :public_view, expires_in: 24.hours),
                      contact_preference: preference
                    ),
                    class: "button-secondary contact-button" %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%= link_to t("quotes.show.new_quote"),
            root_path,
            class: "action-link new-quote-link" %>
    </div>
  </div>
</div>
