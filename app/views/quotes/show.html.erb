<div>
  <h1>Presupuesto de transporte</h1>

  <p>
    <strong>Origen:</strong>
    <%= @quote.origin %>
  </p>

  <p>
    <strong>Destino:</strong>
    <%= @quote.destination %>
  </p>

  <hr>

  <h2>Precio del transporte</h2>

  <p>
    <strong><%= number_to_currency(@calculator.recommended_price, unit: "€") %></strong>
  </p>

  <h2>¿Te interesa este presupuesto?</h2>

  <p>Elige cómo quieres continuar:</p>

  <div>
    <button type="button">Enviar presupuesto por email</button>
    <button type="button">Quiero recibir una llamada</button>
    <button type="button">Quiero recibir contacto por email</button>
  </div>

  <p>
    <%= link_to "Nueva cotización", root_path %>
  </p>
</div>
