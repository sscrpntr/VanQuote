<div class="quote-page">
  <div class="quote-container">
    <header class="quote-header">
      <h1 class="quote-logo">VanQuote</h1>

      <p class="quote-subtitle">
        <%= t("quotes.public.subtitle") %>
      </p>
    </header>

    <div class="quote-card quote-result-card">
      <% if flash[:alert] %>
        <div class="auth-alert" role="alert"><%= flash[:alert] %></div>
      <% end %>

      <div class="route-summary">
        <div class="route-point">
          <span class="route-label"><%= t("quotes.public.origin") %></span>
          <span class="route-address"><%= @quote.origin %></span>
        </div>

        <div class="route-arrow" aria-hidden="true">
          ↓
        </div>

        <div class="route-point">
          <span class="route-label"><%= t("quotes.public.destination") %></span>
          <span class="route-address"><%= @quote.destination %></span>
        </div>
      </div>

      <div class="price-section">
        <p class="price-label"><%= t("quotes.public.price_label") %></p>

        <p class="price-value">
          <%= number_to_currency(
                @calculator.recommended_price,
                unit: "€",
                format: "%n %u"
              ) %>
        </p>

        <p class="price-description">
          <%= t("quotes.public.price_description") %>
        </p>
      </div>

      <div class="contact-section">
        <h2><%= t("quotes.public.contact.title") %></h2>

        <p class="contact-description">
          <%= t("quotes.public.contact.description") %>
        </p>

        <div class="contact-options">
          <% token = @quote.signed_id(purpose: :public_view, expires_in: 24.hours) %>
          <% contact_options = [["EMAIL_QUOTE", "quotes.public.contact.email_quote"], ["PHONE", "quotes.public.contact.phone"], ["EMAIL_CONTACT", "quotes.public.contact.email_contact"]] %>
          <% if Current.user && !@can_request_contact %>
            <p class="auth-alert" role="status"><%= t("quotes.public.contact.account_mismatch") %></p>
          <% else %>
            <% contact_options.each do |preference, label| %>
              <% if Current.user %>
                <%= form_with url: request_quote_contact_path, method: :post, class: "contact-option" do %>
                  <%= hidden_field_tag :token, token %>
                  <%= hidden_field_tag :contact_preference, preference %>
                  <%= submit_tag t(label), class: "button-secondary contact-button" %>
                <% end %>
              <% else %>
                <%= link_to t(label), new_session_path(quote_token: token), class: "button-secondary contact-button" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= link_to t("quotes.public.new_quote"),
            root_path,
            class: "action-link new-quote-link" %>
    </div>
  </div>
</div>
