<div class="quote-page">
  <div class="quote-container">
    <header class="quote-header">
      <h1 class="quote-logo">VanQuote</h1>

      <p class="quote-subtitle">
        <%= t("quotes.public.subtitle") %>
      </p>
    </header>

    <div class="quote-card quote-result-card">
      <div class="route-summary">
        <div class="route-point">
          <span class="route-label"><%= t("quotes.public.origin") %></span>
          <span class="route-address"><%= @quote.origin %></span>
        </div>

        <div class="route-arrow" aria-hidden="true">
          ↓
        </div>

        <div class="route-point">
          <span class="route-label"><%= t("quotes.public.destination") %></span>
          <span class="route-address"><%= @quote.destination %></span>
        </div>
      </div>

      <div class="price-section">
        <p class="price-label"><%= t("quotes.public.price_label") %></p>

        <p class="price-value">
          <%= number_to_currency(
                @calculator.recommended_price,
                unit: "€",
                format: "%n %u"
              ) %>
        </p>

        <p class="price-description">
          <%= t("quotes.public.price_description") %>
        </p>
      </div>

      <div class="contact-section">
        <h2><%= t("quotes.public.contact.title") %></h2>

        <p class="contact-description">
          <%= t("quotes.public.contact.description") %>
        </p>

        <div class="contact-options">
          <%= link_to t("quotes.public.contact.email_quote"),
                new_session_path(
                  quote_token: @quote.signed_id(
                    purpose: :public_view,
                    expires_in: 24.hours
                  ),
                  contact_preference: "EMAIL_QUOTE"
                ),
                class: "button-secondary contact-button" %>

          <%= link_to t("quotes.public.contact.phone"),
                new_session_path(
                  quote_token: @quote.signed_id(
                    purpose: :public_view,
                    expires_in: 24.hours
                  ),
                  contact_preference: "PHONE"
                ),
                class: "button-secondary contact-button" %>

          <%= link_to t("quotes.public.contact.email_contact"),
                new_session_path(
                  quote_token: @quote.signed_id(
                    purpose: :public_view,
                    expires_in: 24.hours
                  ),
                  contact_preference: "EMAIL_CONTACT"
                ),
                class: "button-secondary contact-button" %>
        </div>
      </div>

      <%= link_to t("quotes.public.new_quote"),
            root_path,
            class: "action-link new-quote-link" %>
    </div>
  </div>
</div>
