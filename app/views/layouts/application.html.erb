<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Van Quote" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Van Quote">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <% if Current.user %>
        <nav class="site-navigation" aria-label="<%= t('navigation.account') %>">
          <%= link_to "VanQuote", root_path, class: "site-brand" %>
          <%= link_to t("navigation.my_quotes"), quotes_path, class: "site-navigation-link" %>
          <%= link_to t("navigation.new_quote"), root_path, class: "site-navigation-link" %>
        </nav>
      <% end %>

      <nav class="language-selector" aria-label="Language selector">
        <% available_locales.each_with_index do |locale, index| %>
          <% unless index.zero? %><span class="language-separator" aria-hidden="true">|</span><% end %>
          <% language_label = { "ca" => "CAT", "es" => "ESP", "en" => "ENG" }.fetch(locale) %>
          <%= form_with url: locale_path,
                        method: :post,
                        local: true,
                        class: "language-selector-form" do %>
            <%= hidden_field_tag :locale, locale %>
            <%= hidden_field_tag :return_to, request.path %>

            <%= submit_tag language_label,
                           class: "language-selector-button #{'active' if current_locale == locale}" %>
          <% end %>
        <% end %>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
