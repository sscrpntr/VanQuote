<%# quotes#create re-renders the landing page when the quote is invalid. %>
<% landing_page = controller_name == "quotes" && action_name.in?(%w[new create]) %>
<% public_landing_page = landing_page && !Current.user %>
<% page_classes = ["landing-page-layout"] if landing_page %>
<% page_classes << "landing-authenticated" if landing_page && Current.user %>
<!DOCTYPE html>
<html>
  <head>
    <title><%= public_landing_page ? t("seo.landing.title") : (content_for(:title) || "VanQuote") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Van Quote">
    <meta name="mobile-web-app-capable" content="yes">
    <% if public_landing_page %>
      <meta name="description" content="<%= t('seo.landing.description') %>">
      <link rel="canonical" href="https://van-quote.vercel.app/">
      <meta property="og:title" content="<%= t('seo.landing.title') %>">
      <meta property="og:description" content="<%= t('seo.landing.description') %>">
      <meta property="og:type" content="website">
      <meta property="og:url" content="https://van-quote.vercel.app/">
      <meta property="og:image" content="https://van-quote.vercel.app/vanquote-social.png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:type" content="image/png">
      <meta property="og:image:alt" content="<%= t('seo.landing.image_alt') %>">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content="<%= t('seo.landing.title') %>">
      <meta name="twitter:description" content="<%= t('seo.landing.description') %>">
      <meta name="twitter:image" content="https://van-quote.vercel.app/vanquote-social.png">
      <meta name="twitter:image:alt" content="<%= t('seo.landing.image_alt') %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Layout classes live on <body>: Turbo Drive replaces it on every visit but never updates <html>'s class. %>
  <body class="<%= page_classes&.join(' ') %>" data-controller="locale-form-drafts">
    <header class="site-header <%= 'landing-site-header' if public_landing_page %>"
            <%= tag.attributes data: { controller: ("sticky-header" if landing_page) } %>>
      <% if Current.user && controller_name != "dashboards" %>
        <%= link_to root_path, class: "site-brand", aria: { label: "VanQuote" } do %>
          <%= image_tag "/vanquote-logo.svg", alt: "VanQuote", class: "site-brand-logo", width: 200, height: 40 %>
        <% end %>
        <nav class="site-navigation" aria-label="<%= t('navigation.account') %>">
          <%= link_to t("navigation.my_quotes"), quotes_path, class: "site-navigation-link" %>
          <%= link_to t("navigation.new_quote"), new_quote_path, class: "site-navigation-link" %>
          <%= link_to t("navigation.profile"), profile_path, class: "site-navigation-link" %>
          <%= button_to t("navigation.logout"), session_path, method: :delete, class: "site-navigation-link" %>
        </nav>
      <% elsif public_landing_page %>
        <%= link_to root_path, class: "site-brand", aria: { label: "VanQuote" } do %>
          <%= image_tag "/vanquote-logo.svg", alt: "VanQuote", class: "site-brand-logo", width: 200, height: 40 %>
        <% end %>
      <% end %>

      <nav class="language-selector" aria-label="Language selector">
        <% available_locales.each_with_index do |locale, index| %>
          <% unless index.zero? %><span class="language-separator" aria-hidden="true">|</span><% end %>
          <% language_label = { "ca" => "CAT", "es" => "ESP", "en" => "ENG" }.fetch(locale) %>
          <%= form_with url: locale_path,
                        method: :post,
                        local: true,
                        class: "language-selector-form" do %>
            <%= hidden_field_tag :locale, locale %>
            <%= hidden_field_tag :return_to, request.fullpath %>

            <%= submit_tag language_label,
                           class: "language-selector-button #{'active' if current_locale == locale}" %>
          <% end %>
        <% end %>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
