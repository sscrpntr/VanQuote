<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1><%= t("registrations.new.title") %></h1>

        <p>
          <%= t("registrations.new.subtitle") %>
        </p>
      </div>

      <% if @user.errors.any? %>
        <div class="auth-alert">
          <p>
            <%= t("registrations.new.errors.title") %>
          </p>

          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="auth-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="auth-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with model: @user,
            url: registration_path,
            class: "auth-form" do |form| %>

        <div class="auth-field">
          <%= form.label :email_address, t("registrations.new.email.label") %>

          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "email",
                placeholder: t("registrations.new.email.placeholder") %>
        </div>

        <div class="auth-field">
          <%= form.label :password, t("registrations.new.password.label") %>

          <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                placeholder: t("registrations.new.password.placeholder"),
                maxlength: 72 %>
        </div>

        <div class="auth-field">
          <%= form.label :password_confirmation,
                t("registrations.new.password_confirmation.label") %>

          <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                placeholder: t("registrations.new.password_confirmation.placeholder"),
                maxlength: 72 %>
        </div>

        <%= form.submit t("registrations.new.submit"),
              class: "auth-submit" %>
      <% end %>

      <div class="auth-divider">
        <span><%= t("registrations.new.or") %></span>
      </div>

      <div class="auth-social-preview">
        <button type="button" class="auth-social-button" disabled>
          <span class="auth-social-icon">G</span>
          <span><%= t("registrations.new.google") %></span>
        </button>

        <button type="button" class="auth-social-button" disabled>
          <span class="auth-social-icon">●</span>
          <span><%= t("registrations.new.apple") %></span>
        </button>

        <p>
          <%= t("registrations.new.coming_soon") %>
        </p>
      </div>

      <div class="auth-footer">
        <span><%= t("registrations.new.already_have_account") %></span>

        <%= link_to t("registrations.new.sign_in"),
              new_session_path,
              class: "auth-register-link" %>
      </div>
    </div>

    <p class="auth-back-link">
      <%= link_to t("registrations.new.back_to_vanquote"), root_path %>
    </p>
  </div>
</div>
