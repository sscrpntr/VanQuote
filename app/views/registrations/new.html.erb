<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <% if @user.errors.any? %>
        <div class="auth-alert" role="alert">
          <p><%= t("registrations.new.errors.title") %></p>
          <ul><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <% if flash[:alert] %><div class="auth-alert" role="alert"><%= flash[:alert] %></div><% end %>
      <% if flash[:notice] %><div class="auth-notice" role="status"><%= flash[:notice] %></div><% end %>

      <%= form_with model: @user, url: registration_path, class: "auth-form",
            data: { locale_draft: "registration", controller: "registration-consent",
                    registration_consent_require_communications_value: @operational_consent_required } do |form| %>
        <% if @show_terms_checkbox %>
          <div class="form-consent">
            <%= check_box_tag "user[accept_terms]", "1", locale_form_checked?("registration", "user[accept_terms]", ActiveModel::Type::Boolean.new.cast(params.dig(:user, :accept_terms))), required: true,
                  data: { registration_consent_target: "terms", action: "change->registration-consent#update" } %>
            <%= label_tag "user_accept_terms" do %>
              <%= t("registrations.new.terms_prefix") %><%= link_to t("registrations.new.terms_link"), terms_path, target: "_blank", rel: "noopener" %>
            <% end %>
          </div>
        <% end %>

        <% if @show_operational_checkbox %>
          <div class="form-consent">
            <%= check_box_tag "user[accept_operational_email]", "1", locale_form_checked?("registration", "user[accept_operational_email]", ActiveModel::Type::Boolean.new.cast(params.dig(:user, :accept_operational_email))),
                  required: @operational_consent_required,
                  data: { registration_consent_target: "communications", action: "change->registration-consent#update" } %>
            <%= label_tag "user_accept_operational_email", t("registrations.new.operational_consent_text") %>
          </div>
        <% end %>

      <div class="auth-header">
        <h1><%= t("registrations.new.title") %></h1>

        <p>
          <%= t("registrations.new.subtitle") %>
        </p>
      </div>
        <% unless @oauth_pending %>
        <div class="auth-field">
          <%= form.label :first_name, t("registrations.new.first_name.label") %>

          <%= form.text_field :first_name,
                value: locale_form_value("registration", "user[first_name]", @user.first_name),
                required: true,
                autofocus: true,
                autocomplete: "given-name",
                placeholder: t("registrations.new.first_name.placeholder") %>
        </div>

        <div class="auth-field">
          <%= form.label :last_name, t("registrations.new.last_name.label") %>

          <%= form.text_field :last_name,
                value: locale_form_value("registration", "user[last_name]", @user.last_name),
                required: true,
                autocomplete: "family-name",
                placeholder: t("registrations.new.last_name.placeholder") %>
        </div>

        <div class="auth-field">
          <%= form.label :email_address, t("registrations.new.email.label") %>

          <%= form.email_field :email_address,
                value: locale_form_value("registration", "user[email_address]", @user.email_address),
                required: true,
                autocomplete: "email",
                placeholder: t("registrations.new.email.placeholder") %>
        </div>

        <div class="auth-field">
          <%= form.label :password, t("registrations.new.password.label") %>

          <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                placeholder: t("registrations.new.password.placeholder"),
                maxlength: 72 %>
        </div>

        <div class="auth-field">
          <%= form.label :password_confirmation,
                t("registrations.new.password_confirmation.label") %>

          <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                placeholder: t("registrations.new.password_confirmation.placeholder"),
                maxlength: 72 %>
        </div>
        <% else %>
          <p><%= t("registrations.new.oauth_identity", email: @user.email_address) %></p>
        <% end %>

        <%= form.submit @registration_submit_label,
              class: "button-primary auth-submit",
              disabled: true,
              data: { registration_consent_target: "submit" } %>
      <% end %>

      <% if @oauth_pending %>
        <%= button_to t("registrations.new.cancel_oauth"), cancel_oauth_registration_path, method: :post,
              class: "button-primary auth-submit oauth-cancel-button" %>
      <% else %>

      <div class="auth-divider">
        <span><%= t("registrations.new.or") %></span>
      </div>

      <%= render "shared/social_authentication", translation_scope: "registrations.new" %>

      <div class="auth-footer">
        <span><%= t("registrations.new.already_have_account") %></span>

        <%= link_to t("registrations.new.sign_in"),
              new_session_path(
                quote_token: session[:quote_token_after_authenticating],
                contact_preference: session[:contact_preference_after_authenticating]
              ),
              class: "action-link auth-register-link" %>
      </div>
      <% end %>
    </div>

    <p class="auth-back-link">
      <%= link_to t("registrations.new.back_to_vanquote"),
            session[:quote_token_after_authenticating].present? ? public_quotes_path(token: session[:quote_token_after_authenticating]) : root_path,
            class: "action-link" %>
    </p>
  </div>
</div>
