<div class="auth-page">
  <div class="auth-container">
    <div class="auth-brand">
      <%= link_to "VanQuote", root_path, class: "auth-logo" %>
    </div>

    <div class="auth-card">
      <div class="auth-header">
        <h1>Crea tu cuenta</h1>

        <p>
          Guarda tus presupuestos y gestiona tus solicitudes de transporte.
        </p>
      </div>

      <% if @user.errors.any? %>
        <div class="auth-alert">
          <p>
            No hemos podido crear tu cuenta:
          </p>

          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div class="auth-alert">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="auth-notice">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with model: @user,
            url: registration_path,
            class: "auth-form" do |form| %>

        <div class="auth-field">
          <%= form.label :email_address, "Email" %>

          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "email",
                placeholder: "tu@email.com" %>
        </div>

        <div class="auth-field">
          <%= form.label :password, "Contraseña" %>

          <%= form.password_field :password,
                required: true,
                autocomplete: "new-password",
                placeholder: "Crea una contraseña",
                maxlength: 72 %>
        </div>

        <div class="auth-field">
          <%= form.label :password_confirmation, "Repite tu contraseña" %>

          <%= form.password_field :password_confirmation,
                required: true,
                autocomplete: "new-password",
                placeholder: "Repite tu contraseña",
                maxlength: 72 %>
        </div>

        <%= form.submit "Crear cuenta", class: "auth-submit" %>
      <% end %>

      <div class="auth-divider">
        <span>o</span>
      </div>

      <div class="auth-social-preview">
        <button type="button" class="auth-social-button" disabled>
          <span class="auth-social-icon">G</span>
          <span>Continuar con Google</span>
        </button>

        <button type="button" class="auth-social-button" disabled>
          <span class="auth-social-icon">●</span>
          <span>Continuar con Apple</span>
        </button>

        <p>
          Próximamente
        </p>
      </div>

      <div class="auth-footer">
        <span>¿Ya tienes una cuenta?</span>

        <%= link_to "Iniciar sesión",
              new_session_path,
              class: "auth-register-link" %>
      </div>
    </div>

    <p class="auth-back-link">
      <%= link_to "← Volver a VanQuote", root_path %>
    </p>
  </div>
</div>
