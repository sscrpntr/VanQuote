<section class="profile-page">
  <div class="profile-header">
    <h1><%= t("profile.title") %></h1>
    <p><%= t("profile.description") %></p>
  </div>

  <% if flash[:notice] %>
    <p class="confirmation-message"><%= flash[:notice] %></p>
  <% end %>

  <% if Current.user.errors.any? %>
    <div class="confirmation-message" role="alert">
      <p><strong><%= t("profile.update_failed") %></strong></p>
      <ul>
        <% Current.user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: Current.user, url: profile_path, method: :patch do |form| %>
    <div class="form-field">
      <%= form.label :first_name, t("profile.fields.first_name"), class: "form-label" %>
      <%= form.text_field :first_name, class: "form-input", autocomplete: "given-name" %>
    </div>

    <div class="form-field">
      <%= form.label :last_name, t("profile.fields.last_name"), class: "form-label" %>
      <%= form.text_field :last_name, class: "form-input", autocomplete: "family-name" %>
    </div>

    <div class="form-field">
      <%= form.label :email_address, t("profile.fields.email"), class: "form-label" %>
      <%= form.email_field :email_address, class: "form-input", autocomplete: "email" %>
    </div>

    <div class="form-field">
      <%= form.label :phone, t("profile.fields.phone"), class: "form-label" %>
      <%= form.telephone_field :phone, class: "form-input", autocomplete: "tel" %>
    </div>

    <div class="form-actions">
      <%= form.submit t("profile.save"), class: "button-primary" %>
    </div>
  <% end %>

  <section aria-labelledby="profile-quotes-heading">
    <h2 id="profile-quotes-heading"><%= t("profile.my_quotes") %></h2>
    <p><%= link_to t("profile.view_quotes"), quotes_path, class: "button-secondary" %></p>
  </section>

  <% if Current.user.admin? %>
    <section aria-labelledby="profile-admin-heading">
      <h2 id="profile-admin-heading"><%= t("profile.administration") %></h2>
      <p><%= link_to t("profile.admin_link"), admin_path, class: "button-secondary" %></p>
    </section>
  <% end %>
</section>
