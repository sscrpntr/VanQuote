<section class="profile-page">
  <div class="profile-header">
    <h1>Mi perfil</h1>
    <p>Gestiona tus datos personales y de contacto.</p>
  </div>

  <% if flash[:notice] %>
    <p class="confirmation-message"><%= flash[:notice] %></p>
  <% end %>

  <% if Current.user.errors.any? %>
    <div class="confirmation-message" role="alert">
      <p><strong>No se ha podido actualizar el perfil.</strong></p>
      <ul>
        <% Current.user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: Current.user, url: profile_path, method: :patch do |form| %>
    <div class="form-field">
      <%= form.label :first_name, "Nombre", class: "form-label" %>
      <%= form.text_field :first_name, class: "form-input", autocomplete: "given-name" %>
    </div>

    <div class="form-field">
      <%= form.label :last_name, "Apellidos", class: "form-label" %>
      <%= form.text_field :last_name, class: "form-input", autocomplete: "family-name" %>
    </div>

    <div class="form-field">
      <%= form.label :email_address, "Email", class: "form-label" %>
      <%= form.email_field :email_address, class: "form-input", autocomplete: "email" %>
    </div>

    <div class="form-field">
      <%= form.label :phone, "Teléfono", class: "form-label" %>
      <%= form.telephone_field :phone, class: "form-input", autocomplete: "tel" %>
    </div>

    <div class="form-actions">
      <%= form.submit "Guardar cambios", class: "button-primary" %>
    </div>
  <% end %>

  <section aria-labelledby="profile-quotes-heading">
    <h2 id="profile-quotes-heading">Mis presupuestos</h2>
    <p><%= link_to "Ver mis presupuestos", quotes_path, class: "button-secondary" %></p>
  </section>

  <% if Current.user.admin? %>
    <section aria-labelledby="profile-admin-heading">
      <h2 id="profile-admin-heading">Administración</h2>
      <p><%= link_to "Back-office", admin_path, class: "button-secondary" %></p>
    </section>
  <% end %>
</section>
